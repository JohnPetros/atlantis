generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum DocumentType {
  CPF
  RG
  PASSAPORTE
}

model Customer {
  id               String   @id @default(uuid())
  name             String
  socialName       String
  birthDate        DateTime
  registrationDate DateTime
  isHosted         Boolean  @default(false)

  // Relationships
  cellphones Cellphone[]
  documents  Document[]
  address    Address?
  dependents Customer[]  @relation("CustomerDependents")
  parent     Customer?   @relation("CustomerDependents", fields: [parentId], references: [id])
  parentId   String?

  // Hosting relationship
  hostings Hosting[]

  @@map("customers")
}

model Address {
  id           String @id @default(uuid())
  street       String
  neighborhood String
  city         String
  state        String
  country      String
  zipcode      String

  // Relationships
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String   @unique

  @@map("addresses")
}

model Cellphone {
  id     String @id @default(uuid())
  ddd    String
  number String

  // Relationships
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  @@map("cellphones")
}

model Document {
  id             String       @id @default(uuid())
  number         String
  type           DocumentType
  expeditionDate DateTime

  // Relationships
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  // Hosting relationship
  hostings HostingDocument[]

  @@map("documents")
}

model Accommodation {
  id                 String  @id @default(uuid())
  accommodationName  String
  singleBeds         Int
  coupleBeds         Int
  suites             Int
  garages            Int
  hasAirConditioning Boolean

  // Relationships
  hostings Hosting[]

  @@map("accommodations")
}

model Hosting {
  id                  String @id @default(uuid())
  accommodationId     String
  accommodationName   String
  hostId              String
  hostName            String
  hostDependentsCount Int

  // Relationships
  accommodation Accommodation     @relation(fields: [accommodationId], references: [id])
  host          Customer          @relation(fields: [hostId], references: [id])
  hostDocuments HostingDocument[]

  @@map("hostings")
}

model HostingDocument {
  id         String @id @default(uuid())
  hostingId  String
  documentId String

  // Relationships
  hosting  Hosting  @relation(fields: [hostingId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([hostingId, documentId])
  @@map("hosting_documents")
}
